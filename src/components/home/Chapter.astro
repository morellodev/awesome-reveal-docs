---
import { Code } from "@astrojs/starlight/components";
import { Cascade } from "@awesome-reveal/astro";
import RotateCcw from "@lucide/astro/icons/rotate-ccw";

interface Props {
  id: string;
  number: string;
  option: string;
  title: string;
  code: string;
  replay?: boolean;
}

const { id, number, option, title, code, replay = true } = Astro.props;
---

<section
  id={id}
  class="chapter not-content"
  aria-labelledby={`${id}-title`}
  data-slide
>
  <Cascade class="copy" interval={90} threshold={0.2}>
    <p class="kicker" data-markdown-ignore>
      <span class="number">{number}</span>
      <code>{option}</code>
    </p>
    <h2 id={`${id}-title`}>{title}</h2>
    <div class="body">
      <slot />
    </div>
    <Code code={code} lang="jsx" />
  </Cascade>
  <div class="stage" data-markdown-ignore>
    <slot name="stage" />
    {replay && (
      <button type="button" class="replay">
        <RotateCcw aria-hidden="true" />
        Replay
      </button>
    )}
  </div>
</section>

<script>
  for (const button of document.querySelectorAll(".chapter .replay")) {
    button.addEventListener("click", () => {
      for (const host of button
        .closest(".stage")
        ?.querySelectorAll("awesome-reveal") ?? []) {
        host.when = false;
        host.when = true;
      }
    });
  }
</script>

<style>
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: 2.5rem;
    min-block-size: calc(100svh - var(--sl-nav-height));
    padding-block: 4rem;
  }

  @media (min-width: 56rem) {
    .chapter {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: 4rem;
    }

    .chapter:nth-of-type(even) .copy {
      order: 1;
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .kicker {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .number {
    font-family: var(--sl-font-mono);
    font-weight: 700;
  }

  .kicker code {
    padding: 0.2em 0.6em;
    border-radius: 999px;
    background-color: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 700;
  }

  h2 {
    color: var(--sl-color-white);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .body {
    max-width: 32rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .body :global(code) {
    font-size: 0.85em;
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: min(28rem, 70svh);
    padding: 3.5rem 1.5rem 2rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--radius-md);
    background-color: color-mix(
      in oklab,
      var(--sl-color-gray-6) 70%,
      transparent
    );
  }

  .replay {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-end: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--hover-duration) ease;

    &:hover {
      border-color: var(--sl-color-text-accent);
      color: var(--sl-color-white);
    }
  }

  /* With reduced motion, `when: false` does not reset the entrance, so there is nothing to replay. */
  @media (prefers-reduced-motion: reduce) {
    .replay {
      display: none;
    }
  }
</style>
