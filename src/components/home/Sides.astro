---
import { Reveal } from "@awesome-reveal/astro";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowUp from "@lucide/astro/icons/arrow-up";
import Chapter from "./Chapter.astro";

const code = `<Reveal from="left">
  <Card />
</Reveal>`;

const sides = [
  { side: "top", Arrow: ArrowDown, delay: 0 },
  { side: "right", Arrow: ArrowLeft, delay: 90 },
  { side: "bottom", Arrow: ArrowUp, delay: 180 },
  { side: "left", Arrow: ArrowRight, delay: 270 },
] as const;
---

<Chapter
  id="fade-in-from-any-side"
  number="01"
  option="from"
  title="Fade in from any side"
  code={code}
>
  <p>
    Choose <code>top</code>, <code>right</code>, <code>bottom</code> or{" "}
    <code>left</code>. The element fades in and slides 24 pixels from that side.
    One prop, no CSS.
  </p>
  <div slot="stage" class="compass">
    {sides.map(({ side, Arrow, delay }) => (
      <Reveal
        class:list={["side", side]}
        from={side}
        duration={800}
        delay={delay}
        threshold={0.6}
      >
        <Arrow aria-hidden="true" />
        <code>"{side}"</code>
      </Reveal>
    ))}
    <span class="center">from</span>
  </div>
</Chapter>

<style>
  .compass {
    display: grid;
    grid-template-areas:
      ". top ."
      "left center right"
      ". bottom .";
    grid-template-columns: repeat(3, minmax(0, 7rem));
    gap: 0.75rem;
  }

  .side {
    display: grid;
    place-items: center;
    gap: 0.25rem;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    background-color: var(--marker);
    color: var(--ink);
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
  }

  .side code {
    font-size: var(--sl-text-xs);
    font-weight: 700;
  }

  .top {
    grid-area: top;
  }

  .right {
    grid-area: right;
    background-color: var(--pencil);
  }

  .bottom {
    grid-area: bottom;
  }

  .left {
    grid-area: left;
    background-color: var(--pencil);
  }

  .center {
    grid-area: center;
    place-self: center;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
  }
</style>
