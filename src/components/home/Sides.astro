---
import { Reveal } from "@awesome-reveal/astro";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowUp from "@lucide/astro/icons/arrow-up";
import Chapter from "./Chapter.astro";

const sides = [
  { side: "top", Arrow: ArrowDown },
  { side: "right", Arrow: ArrowLeft },
  { side: "bottom", Arrow: ArrowUp },
  { side: "left", Arrow: ArrowRight },
] as const;
const selected = "left";

const control = {
  name: "from",
  selected,
  options: sides.map(({ side }) => ({
    value: side,
    code: `<Reveal from="${side}">
  <Card />
</Reveal>`,
  })),
};
---

<Chapter
  id="fade-in-from-any-side"
  label="Directions"
  title="Fade in from any side"
  control={control}
  mark={/from="\w+"/g}
>
  <p>
    Choose <code>top</code>, <code>right</code>, <code>bottom</code> or{" "}
    <code>left</code>. The element fades in and slides 24 pixels from that side.
    One prop, no CSS.
  </p>
  <div slot="stage" class="compass">
    {sides.map(({ side, Arrow }, index) => (
      <Reveal
        class:list={["side", side]}
        data-choice={side}
        data-selected={side === selected ? "" : undefined}
        from={side}
        duration={800}
        delay={index * 90}
        threshold={0.6}
      >
        <Arrow aria-hidden="true" />
        <code>"{side}"</code>
      </Reveal>
    ))}
    <span class="center">from</span>
  </div>
</Chapter>

<style>
  .compass {
    display: grid;
    grid-template-areas:
      ". top ."
      "left center right"
      ". bottom .";
    grid-template-columns: repeat(3, minmax(0, 6.5rem));
    gap: 0.75rem;
  }

  .side {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    background-color: var(--marker);
    color: var(--ink);
    font-size: clamp(1.5rem, 1rem + 2vw, 2rem);
    outline: 3px solid transparent;
    outline-offset: 4px;
    transition: outline-color var(--hover-duration) ease;
  }

  .side[data-selected] {
    outline-color: var(--sl-color-white);
  }

  .side code {
    font-size: var(--sl-text-xs);
    font-weight: 700;
  }

  .top {
    grid-area: top;
  }

  .right {
    grid-area: right;
    background-color: var(--pencil);
  }

  .bottom {
    grid-area: bottom;
  }

  .left {
    grid-area: left;
    background-color: var(--pencil);
  }

  .center {
    grid-area: center;
    place-self: center;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
  }
</style>
