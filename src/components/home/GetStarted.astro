---
import { Code, LinkButton, TabItem, Tabs } from "@astrojs/starlight/components";
import { Reveal } from "@awesome-reveal/astro";
import Github from "../../assets/github.svg";

const frameworks = [
  {
    label: "React",
    pkg: "@awesome-reveal/react",
    lang: "jsx",
    code: `import { Reveal } from "@awesome-reveal/react";

export const Hero = () => (
  <Reveal from="left">
    <h1>Hello</h1>
  </Reveal>
);`,
  },
  {
    label: "Vue",
    pkg: "@awesome-reveal/vue",
    lang: "vue",
    code: `<script setup>
import { Reveal } from "@awesome-reveal/vue";
</script>

<template>
  <Reveal from="left">
    <h1>Hello</h1>
  </Reveal>
</template>`,
  },
  {
    label: "Astro",
    pkg: "@awesome-reveal/astro",
    lang: "astro",
    // A line that starts with `---` ends the frontmatter for editor parsers, so the fences are interpolated.
    code: `${"---"}
import { Reveal } from "@awesome-reveal/astro";
${"---"}

<Reveal from="left">
  <h1>Hello</h1>
</Reveal>`,
  },
  {
    label: "JavaScript",
    pkg: "@awesome-reveal/core",
    lang: "js",
    code: `import { reveal } from "@awesome-reveal/core";

reveal("h1", { from: "left" });`,
  },
];
---

<section
  id="get-started"
  class="get-started not-content"
  aria-labelledby="get-started-title"
  data-slide
>
  <Reveal class="intro" threshold={0.5}>
    <h2 id="get-started-title">Start in under a minute</h2>
    <p>
      Pick your framework, install one package and wrap an element. All four
      packages share the same core, the same entrance options and TypeScript
      types.
    </p>
  </Reveal>
  <Reveal class="code" threshold={0.2} delay={120}>
    <Tabs syncKey="framework">
      {frameworks.map(({ label, pkg, lang, code }) => (
        <TabItem label={label}>
          <Code code={`npm install ${pkg}`} lang="shell" wrap />
          <Code code={code} lang={lang} wrap />
        </TabItem>
      ))}
    </Tabs>
  </Reveal>
  <Reveal class="actions" threshold={0.5} from={{ opacity: 0, y: 12 }}>
    <LinkButton
      href="https://github.com/awesome-reveal/awesome-reveal"
      variant="primary"
    >
      Star on GitHub
      <Github aria-hidden="true" width="1em" height="1em" />
    </LinkButton>
  </Reveal>
</section>

<style>
  .get-started {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: 2.5rem;
    min-block-size: calc(100svh - var(--sl-nav-height));
    padding-block: 4rem 6rem;
  }

  @media (min-width: 56rem) {
    .get-started {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
      gap: 2.5rem 4rem;
    }

    .code {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .actions {
      grid-column: 1;
      grid-row: 2;
    }
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  h2 {
    color: var(--sl-color-white);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  p {
    max-width: 32rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
  }

  .code {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .code :global(.expressive-code + .expressive-code) {
    margin-block-start: 1rem;
  }

  /* The panels share one cell, so the tallest sets the height and a tab change does not move the centered section. */
  .code :global(starlight-tabs) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .code :global(starlight-tabs > [role="tabpanel"]) {
    grid-area: 2 / 1;
  }

  .code :global(starlight-tabs > [role="tabpanel"][hidden]) {
    display: block;
    visibility: hidden;
  }

  /* On touch screens, the copy button always shows, so the lines wrap before they reach it. */
  @media (hover: none) {
    .code :global(.expressive-code .ec-line .code) {
      padding-inline-end: calc(var(--ec-codePadInl) + 2.5rem);
    }
  }

  @media (max-width: 30rem) {
    .code {
      --ec-codeFontSize: 0.8125rem;
    }
  }

  .sl-link-button {
    font-weight: 700;
  }

  .sl-link-button :global(svg) {
    font-size: 1.5rem;
  }
</style>
