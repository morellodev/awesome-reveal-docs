---
import { Cascade, Reveal } from "@awesome-reveal/astro";
import CirclePause from "@lucide/astro/icons/circle-pause";
import EyeOff from "@lucide/astro/icons/eye-off";
import Gauge from "@lucide/astro/icons/gauge";
import Search from "@lucide/astro/icons/search";
---

<section
  id="accessible-by-default"
  class="defaults not-content"
  aria-labelledby="accessible-by-default-title"
  data-slide
>
  <Reveal as="h2" id="accessible-by-default-title" threshold={0.5}>
    Accessible and SEO friendly by default
  </Reveal>
  <Cascade as="ul" class="points" interval={100} threshold={0.2}>
    <li>
      <Search aria-hidden="true" />
      <h3>SEO friendly</h3>
      <p>
        Search engines and screen readers read all of your content. It is in the
        HTML before any animation plays.
      </p>
    </li>
    <li>
      <EyeOff aria-hidden="true" />
      <h3>No flicker on load</h3>
      <p>
        With the React, Vue and Astro packages, content does not blink into view
        before its entrance. If the script fails, it shows after 5 seconds.
      </p>
    </li>
    <li>
      <CirclePause aria-hidden="true" />
      <h3>Respects motion settings</h3>
      <p>
        Visitors who ask their device for reduced motion see the content at
        once, with no animation.
      </p>
      <p class="motion" data-markdown-ignore hidden>
        Your device: <strong></strong>
      </p>
    </li>
    <li>
      <Gauge aria-hidden="true" />
      <h3>Fast and smooth</h3>
      <p>
        Pages stay light, and the motion runs smoothly. The browser does the
        work with its own APIs, so no animation library ships to your visitors.
      </p>
    </li>
  </Cascade>
</section>

<script>
  const badge = document.querySelector<HTMLElement>(".motion");
  const label = badge?.querySelector("strong");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  function showMotionPreference() {
    if (!badge || !label) return;
    label.textContent = reduced.matches ? "reduced motion" : "full motion";
    badge.hidden = false;
  }

  showMotionPreference();
  reduced.addEventListener("change", showMotionPreference);
</script>

<style>
  .defaults {
    display: grid;
    align-content: center;
    gap: 3rem;
    min-block-size: calc(100svh - var(--sl-nav-height));
    padding-block: 4rem;
  }

  h2 {
    max-width: 18ch;
    color: var(--sl-color-white);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 2.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block-start: 1.25rem;
    border-top: 2px solid var(--sl-color-white);
  }

  li > :global(svg) {
    margin-block-end: 0.5rem;
    color: var(--sl-color-text-accent);
    font-size: 1.75rem;
  }

  h3 {
    color: var(--sl-color-white);
    font-size: 1.375rem;
    line-height: 1.15;
  }

  p {
    color: var(--sl-color-gray-3);
  }

  .motion {
    align-self: flex-start;
    margin-block-start: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background-color: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-sm);

    &[hidden] {
      display: none;
    }
  }
</style>
