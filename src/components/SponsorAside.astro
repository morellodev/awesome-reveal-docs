---
import { Aside } from "@astrojs/starlight/components";
import { siteConfig } from "../site.config";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Aside type="tip" icon="heart" title={title}>
  Awesome Reveal is free and open source. A{" "}
  <a href={siteConfig.sponsorUrl}>sponsorship on GitHub</a>, from $1 a month,
  helps to keep it maintained and up to date.
</Aside>
