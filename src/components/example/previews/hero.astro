---
import { Reveal } from "@awesome-reveal/astro";
import { heroTitle } from "../../../lib/use-cases/hero";
import type { PreviewProps as Props } from "../../../lib/use-cases";

const { options } = Astro.props;
const splits = ["words", "letters"];
---

<div class="hero">
  <span class="eyebrow">Version 1.0</span>
  {splits.map((split, host) => (
    <p class="title" data-split={split}>
      <span class="sr-only">{heroTitle}</span>
      <Reveal as="span" class={split} aria-hidden="true" {...options[host]}>
        {split === "words"
          ? heroTitle.split(" ").map((word, index) => (
              <>
                {index > 0 && " "}
                <span>{word}</span>
              </>
            ))
          : [...`${heroTitle} `].map((letter) => (
              <span class:list={{ space: letter === " " }}>{letter}</span>
            ))}
      </Reveal>
    </p>
  ))}
  <p class="lead">
    Reveal animations for React, Vue, Astro and plain JavaScript.
  </p>
  <div class="actions">
    <span class="button primary">Get started</span>
    <span class="button">Read the docs</span>
  </div>
</div>

<style>
  .hero {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    max-width: 26rem;
    text-align: center;
  }
  .eyebrow {
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--pv-border);
    border-radius: 999rem;
    font-size: var(--sl-text-xs);
    color: var(--pv-muted);
  }
  .title {
    margin: 0;
    font-size: clamp(1.75rem, 7cqi, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--pv-text);
    text-wrap: balance;
  }
  /* The split radios of the example form select the visible title. */
  :global(.example:has([name="split"][value="letters"]:checked))
    [data-split="words"],
  :global(.example:has([name="split"][value="words"]:checked))
    [data-split="letters"] {
    display: none;
  }
  .letters {
    white-space: nowrap;
  }
  /* Transforms do not apply to inline elements. */
  .words > span,
  .letters > span {
    display: inline-block;
  }
  /* Wrap only at a space. Firefox needs one after the last word. */
  .letters > .space {
    display: inline;
    white-space: normal;
  }
  .lead {
    margin: 0;
    color: var(--pv-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .button {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--pv-border);
    border-radius: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--pv-text);
  }
  .button.primary {
    border-color: transparent;
    background: var(--pv-accent);
    color: var(--pv-on-accent);
  }
</style>
