---
import { Reveal } from "@awesome-reveal/astro";
import { photoCaption } from "../../../lib/use-cases/media";
import type { PreviewProps as Props } from "../../../lib/use-cases";

const { options } = Astro.props;
---

<Reveal as="figure" class="photo" {...options[0]}>
  <svg
    viewBox="0 0 320 180"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="media-sky" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#fbbf77"></stop>
        <stop offset="1" stop-color="#f6e7c8"></stop>
      </linearGradient>
    </defs>
    <rect width="320" height="180" fill="url(#media-sky)"></rect>
    <circle cx="210" cy="96" r="30" fill="#fff4dc"></circle>
    <path d="M0 120 Q80 70 170 112 T320 100 V180 H0Z" fill="#7aa874"></path>
    <path d="M0 150 Q110 104 210 142 T320 136 V180 H0Z" fill="#4f7f55"></path>
  </svg>
  <figcaption>{photoCaption}</figcaption>
</Reveal>

<style>
  .photo {
    display: grid;
    gap: 0.5rem;
    width: min(100%, 24rem);
    margin: 0;
  }
  svg {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
  }
  figcaption {
    font-size: var(--sl-text-sm);
    color: var(--pv-muted);
    text-align: center;
  }
</style>
