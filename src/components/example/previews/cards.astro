---
import { Reveal } from "@awesome-reveal/astro";
import Accessibility from "@lucide/astro/icons/accessibility";
import Package from "@lucide/astro/icons/package";
import Zap from "@lucide/astro/icons/zap";
import { features } from "../../../lib/use-cases/cards";
import type { PreviewProps as Props } from "../../../lib/use-cases";

const { options } = Astro.props;
const icons = [Zap, Accessibility, Package];
---

<div class="wrapper">
  <p class="heading">Why teams pick it</p>
  <Reveal class="features" {...options[0]}>
    {features.map(({ title, text }, index) => {
      const Icon = icons[index]!;
      return (
        <article class="card">
          <span class="icon">
            <Icon size="1.125em" />
          </span>
          <p class="card-title">{title}</p>
          <p class="card-text">{text}</p>
        </article>
      );
    })}
  </Reveal>
</div>

<style>
  .wrapper {
    display: grid;
    gap: 1rem;
    width: 100%;
  }
  .heading {
    margin: 0;
    font-size: var(--sl-text-xl);
    font-weight: 700;
    text-align: center;
    color: var(--pv-text);
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem;
  }
  .card {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    padding: 1rem;
    border: 1px solid var(--pv-border);
    border-radius: 0.75rem;
    background: var(--pv-surface);
  }
  .icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background: var(--pv-accent-soft);
    color: var(--pv-accent-text);
  }
  .card-title {
    margin: 0.25rem 0 0;
    font-weight: 600;
    color: var(--pv-text);
  }
  .card-text {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--pv-muted);
  }
</style>
