---
import { Reveal } from "@awesome-reveal/astro";
import { figures } from "../../../lib/use-cases/stats";
import type { PreviewProps as Props } from "../../../lib/use-cases";

const { options } = Astro.props;
---

<Reveal as="dl" class="stats" {...options[0]}>
  {figures.map(({ label, value }) => (
    <div>
      <dt>{label}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</Reveal>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    width: min(100%, 26rem);
    margin: 0;
  }
  div {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 0.25rem;
    padding: 1rem 0.5rem;
    border: 1px solid var(--pv-border);
    border-radius: 0.75rem;
    background: var(--pv-surface);
  }
  dt {
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--pv-muted);
  }
  dd {
    margin: 0;
    font-size: clamp(1.5rem, 6cqi, 2.25rem);
    font-weight: 700;
    line-height: 1;
    color: var(--pv-accent-text);
  }
</style>
