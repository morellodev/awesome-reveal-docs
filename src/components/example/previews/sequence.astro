---
import { Reveal } from "@awesome-reveal/astro";
import { heroTitle } from "../../../lib/use-cases/hero";
import { heroLead } from "../../../lib/use-cases/sequence";
import type { PreviewProps as Props } from "../../../lib/use-cases";

const { options } = Astro.props;
---

<div class="hero">
  <Reveal as="p" class="title" {...options[0]}>
    {heroTitle}
  </Reveal>
  <Reveal as="p" class="lead" {...options[1]}>
    {heroLead}
  </Reveal>
  <Reveal class="actions" {...options[2]}>
    <span class="button primary">Get started</span>
    <span class="button">Read the docs</span>
  </Reveal>
</div>

<style>
  .hero {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    max-width: 26rem;
    text-align: center;
  }
  .title {
    margin: 0;
    font-size: clamp(1.75rem, 7cqi, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--pv-text);
    text-wrap: balance;
  }
  .lead {
    margin: 0;
    color: var(--pv-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .button {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--pv-border);
    border-radius: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--pv-text);
  }
  .button.primary {
    border-color: transparent;
    background: var(--pv-accent);
    color: var(--pv-on-accent);
  }
</style>
