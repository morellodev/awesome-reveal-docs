---
import { Reveal } from "@awesome-reveal/astro";
import type { PreviewProps as Props } from "../../../lib/use-cases";

const { options } = Astro.props;
---

<div class="page">
  <span class="line"></span>
  <span class="line short"></span>
  <Reveal class="cta" {...options[0]}>
    <span class="title">Ready to start?</span>
    <span class="text">Install the package for your framework.</span>
    <span class="button">Get started</span>
  </Reveal>
</div>

<style>
  .page {
    display: grid;
    gap: 0.625rem;
    width: min(100%, 24rem);
  }
  .line {
    height: 0.625rem;
    border-radius: 999rem;
    background: var(--pv-border);
  }
  .short {
    width: 70%;
    margin-bottom: 0.75rem;
  }
  .cta {
    display: grid;
    justify-items: center;
    gap: 0.375rem;
    padding: 1.5rem 1rem;
    border-radius: 1rem;
    background: var(--pv-gradient);
    text-align: center;
    color: var(--pv-on-accent);
  }
  .title {
    font-size: var(--sl-text-xl);
    font-weight: 700;
  }
  .text {
    font-size: var(--sl-text-sm);
  }
  .button {
    margin-top: 0.5rem;
    padding: 0.375rem 1rem;
    border-radius: 999rem;
    background: var(--pv-on-accent);
    color: var(--pv-text);
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }
</style>
