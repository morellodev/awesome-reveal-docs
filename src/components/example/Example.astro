---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";
import Link from "@lucide/astro/icons/link";
import RotateCcw from "@lucide/astro/icons/rotate-ccw";
import type { Lang } from "../../lib/code-highlight";
import {
  findUseCase,
  frameworks,
  type PreviewProps,
  type Snippets,
} from "../../lib/use-cases";
import { libraryTiming } from "../../lib/use-cases/code";

interface Props {
  useCase: string;
}

const previews = import.meta.glob<{
  default: (props: PreviewProps) => unknown;
}>("./previews/*.astro", { eager: true });

const useCase = findUseCase(Astro.props.useCase);
if (!useCase) throw new Error(`Unknown use case: ${Astro.props.useCase}`);
const Preview = previews[`./previews/${useCase.id}.astro`]?.default;
if (!Preview) throw new Error(`No preview for the use case: ${useCase.id}`);
const { duration, delay } = { ...libraryTiming, ...useCase.timing };
const ranges = [
  { name: "duration", label: "Duration", min: 100, max: 2000, value: duration },
  { name: "delay", label: "Delay", min: 0, max: 1000, value: delay },
];
const values = {
  ...Object.fromEntries(
    useCase.tweaks.map((tweak) => [tweak.name, tweak.default]),
  ),
  duration,
  delay,
};
const snippets = useCase.snippets(values);
const { component } = useCase;
const blocks: Record<keyof Snippets, { lang: Lang; title: string }> = {
  react: { lang: "jsx", title: `${component}.jsx` },
  vue: { lang: "vue", title: `${component}.vue` },
  astro: { lang: "astro", title: `${component}.astro` },
  html: { lang: "html", title: "index.html" },
  javascript: { lang: "js", title: "main.js" },
  css: { lang: "css", title: "styles.css" },
};
---

<div class="example not-content" data-example={useCase.id}>
  <div class="stage" data-markdown-ignore>
    <div class="stage-bar">
      <button type="button" class="action" data-replay>
        <RotateCcw size="1em" />
        Replay
      </button>
      <button type="button" class="action" data-share>
        <Link size="1em" />
        <span data-share-label>Copy link</span>
      </button>
      <span class="sr-only" role="status" data-share-status></span>
    </div>
    <div class="canvas" data-preview>
      <Preview options={useCase.preview(values)} />
    </div>
    <p class="motion-note">
      Your system reduces motion, so the preview does not animate. The code
      still follows your choices.
    </p>
  </div>

  <form class="tweaks" data-markdown-ignore>
    {useCase.tweaks.map((tweak) => (
      <fieldset class="tweak">
        <legend>{tweak.label}</legend>
        <div class="segmented">
          {tweak.options.map((option) => (
            <label>
              <input
                type="radio"
                class="sr-only"
                name={tweak.name}
                value={option.value}
                checked={option.value === tweak.default}
              />
              <span>{option.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}
    <div class="more">
      <details class="fine-tune">
        <summary>Fine-tune</summary>
        <div class="ranges">
          {ranges.map(({ name, label, min, max, value }) => {
            const id = `${useCase.id}-${name}`;
            return (
              <div class="range">
                <label for={id}>{label}</label>
                <output for={id} aria-live="off">
                  {value}ms
                </output>
                <input
                  type="range"
                  id={id}
                  name={name}
                  min={min}
                  max={max}
                  step={50}
                  value={value}
                  aria-valuetext={`${value} milliseconds`}
                />
              </div>
            );
          })}
        </div>
      </details>
      <button type="reset" class="action" aria-disabled="true">
        Reset
      </button>
    </div>
  </form>

  <div class="snippets">
    <Tabs syncKey="framework">
      {frameworks.map(({ key, label, icon }) => (
        <TabItem label={label} icon={icon}>
          {(key === "javascript" ? (["html", key] as const) : [key]).map(
            (file) => (
              <div data-snippet={file}>
                <Code code={snippets[file]} {...blocks[file]} />
              </div>
            ),
          )}
        </TabItem>
      ))}
    </Tabs>
    {snippets.css && (
      <div data-snippet="css">
        <Code code={snippets.css} {...blocks.css} />
      </div>
    )}
  </div>
</div>

<script>
  import {
    highlight,
    loadHighlighter,
    plainLines,
    type Lang,
  } from "../../lib/code-highlight";
  import {
    findUseCase,
    frameworks,
    type Framework,
    type Snippets,
  } from "../../lib/use-cases";

  type TabsElement = HTMLElement & {
    tabs: HTMLAnchorElement[];
    switchTab(tab: HTMLAnchorElement, index: number, sync: boolean): void;
  };

  const root = document.querySelector<HTMLElement>("[data-example]");
  const useCase = root && findUseCase(root.dataset.example);
  if (root && useCase) {
    const form = root.querySelector("form")!;
    const tabs = root.querySelector<TabsElement>("starlight-tabs")!;
    const resetButton = form.querySelector<HTMLButtonElement>("[type=reset]")!;
    const fineTune = form.querySelector("details")!;
    // The server renders the defaults, so `defaultChecked` and `defaultValue` keep them.
    const controls = [...form.querySelectorAll("input")];
    const isRange = (input: HTMLInputElement) => input.type === "range";
    const isDefault = (input: HTMLInputElement) =>
      isRange(input)
        ? input.value === input.defaultValue
        : input.checked === input.defaultChecked;
    const selected = () =>
      controls.filter((input) => isRange(input) || input.checked);

    const readValues = () =>
      Object.fromEntries(
        selected().map((input) => [
          input.name,
          isRange(input) ? input.valueAsNumber : input.value,
        ]),
      );

    const showControls = () => {
      for (const output of form.querySelectorAll("output")) {
        const input = output.nextElementSibling as HTMLInputElement;
        output.textContent = `${input.value}ms`;
        input.setAttribute("aria-valuetext", `${input.value} milliseconds`);
      }
      // `disabled` would drop the focus of a reader who just pressed Reset.
      resetButton.setAttribute(
        "aria-disabled",
        String(controls.every(isDefault)),
      );
    };

    // A new `<awesome-reveal>` element hides its child and reveals it again.
    const replay = () => {
      const options = useCase.preview(readValues());
      root
        .querySelectorAll("[data-preview] awesome-reveal")
        .forEach((host, index) => {
          const next = host.cloneNode(true) as HTMLElement;
          next.setAttribute("options", JSON.stringify(options[index]));
          host.replaceWith(next);
        });
    };

    const sourceOf = (block: Element) =>
      [
        block
          .querySelector("button[data-code]")!
          .getAttribute("data-code")!
          .replaceAll("\u007f", "\n"),
        block.querySelector("pre")!.dataset.language as Lang,
      ] as const;

    const startHighlighter = () =>
      loadHighlighter(
        [...root.querySelectorAll("[data-snippet]")].map(sourceOf),
      );

    const colorPlainBlocks = () => {
      for (const block of root.querySelectorAll("[data-plain]")) {
        block.querySelector("pre code")!.innerHTML = highlight(
          ...sourceOf(block),
        )!;
        block.removeAttribute("data-plain");
      }
    };

    const showCode = () => {
      const snippets = useCase.snippets(readValues());
      for (const block of root.querySelectorAll<HTMLElement>(
        "[data-snippet]",
      )) {
        const code = snippets[block.dataset.snippet as keyof Snippets] ?? "";
        // The copy button of Expressive Code reads this attribute, with U+007F for line breaks.
        const copy = block.querySelector("button[data-code]")!;
        const copyCode = code.replaceAll("\n", "\u007f");
        if (copy.getAttribute("data-code") === copyCode) continue;
        copy.setAttribute("data-code", copyCode);
        const pre = block.querySelector("pre")!;
        const html = highlight(code, pre.dataset.language as Lang);
        pre.querySelector("code")!.innerHTML = html ?? plainLines(code);
        block.toggleAttribute("data-plain", !html);
      }
      if (root.querySelector("[data-plain]"))
        startHighlighter().then(colorPlainBlocks, () => undefined);
    };

    const selectedFramework = (): Framework | undefined => {
      const index = tabs.tabs.findIndex(
        (tab) => tab.getAttribute("aria-selected") === "true",
      );
      return index > 0 ? frameworks[index]?.key : undefined;
    };

    const selectFramework = (key: string | null) => {
      const index = frameworks.findIndex((framework) => framework.key === key);
      // A shared link must not change the framework that the reader saved.
      if (index >= 0) tabs.switchTab(tabs.tabs[index]!, index, false);
    };

    const writeUrl = () => {
      const url = new URL(location.href);
      // Other keys, such as campaign parameters, stay in the URL.
      for (const { name } of controls) url.searchParams.delete(name);
      url.searchParams.delete("framework");
      for (const input of selected())
        if (!isDefault(input)) url.searchParams.set(input.name, input.value);
      const framework = selectedFramework();
      if (framework) url.searchParams.set("framework", framework);
      if (url.href !== location.href)
        history.replaceState(history.state, "", url);
    };

    let urlTimer: ReturnType<typeof setTimeout>;
    const scheduleUrl = () => {
      clearTimeout(urlTimer);
      urlTimer = setTimeout(writeUrl, 250);
    };

    const update = () => {
      showControls();
      replay();
      showCode();
    };

    let previewTimer: ReturnType<typeof setTimeout>;
    form.addEventListener("input", (event) => {
      showControls();
      showCode();
      scheduleUrl();
      // A drag of a range fires many events. The preview replays when the drag pauses.
      clearTimeout(previewTimer);
      if (isRange(event.target as HTMLInputElement))
        previewTimer = setTimeout(replay, 250);
      else replay();
    });
    form.addEventListener("submit", (event) => event.preventDefault());
    // Start the download before the first change, so the code keeps its colors.
    for (const type of ["pointerover", "focusin"])
      form.addEventListener(type, () => startHighlighter().catch(() => {}), {
        once: true,
      });
    resetButton.addEventListener("click", (event) => {
      if (resetButton.getAttribute("aria-disabled") === "true")
        event.preventDefault();
    });
    form.addEventListener("reset", () => {
      clearTimeout(previewTimer);
      // The form restores its controls after the reset event.
      setTimeout(() => {
        update();
        scheduleUrl();
      });
    });

    root.querySelector("[data-replay]")!.addEventListener("click", replay);

    const status = root.querySelector<HTMLElement>("[data-share-status]")!;
    const label = root.querySelector<HTMLElement>("[data-share-label]")!;
    let statusTimer: ReturnType<typeof setTimeout>;
    root.querySelector("[data-share]")!.addEventListener("click", async () => {
      clearTimeout(urlTimer);
      writeUrl();
      try {
        await navigator.clipboard.writeText(location.href);
        status.textContent = "Link copied";
        label.textContent = "Copied";
      } catch {
        status.textContent = "Copy the link from the address bar.";
        label.textContent = "Copy failed";
      }
      clearTimeout(statusTimer);
      statusTimer = setTimeout(() => {
        status.textContent = "";
        label.textContent = "Copy link";
      }, 2000);
    });

    await customElements.whenDefined("starlight-tabs");
    const search = new URLSearchParams(location.search);
    selectFramework(search.get("framework"));
    for (const input of controls) {
      const raw = search.get(input.name);
      if (raw === null) continue;
      if (!isRange(input)) {
        if (input.value === raw) input.checked = true;
        continue;
      }
      input.value = raw;
      // The browser clamps, rounds or drops a value that the range cannot hold.
      if (input.valueAsNumber !== Number(raw)) input.value = input.defaultValue;
    }
    if (!controls.every(isDefault)) {
      fineTune.open = controls.some(
        (input) => isRange(input) && !isDefault(input),
      );
      update();
    }
    new MutationObserver(scheduleUrl).observe(tabs, {
      subtree: true,
      attributeFilter: ["aria-selected"],
    });
  }
</script>

<style>
  .example {
    --pv-bg: var(--sl-color-bg);
    --pv-surface: var(--sl-color-bg-nav);
    --pv-border: var(--sl-color-gray-5);
    --pv-text: var(--sl-color-white);
    --pv-muted: var(--sl-color-gray-2);
    --pv-accent: var(--sl-color-accent);
    --pv-accent-text: var(--sl-color-text-accent);
    --pv-accent-soft: var(--sl-color-accent-low);
    --pv-on-accent: var(--sl-color-black);
    --pv-gradient: linear-gradient(
      135deg,
      var(--sl-color-accent),
      var(--sl-color-accent-high)
    );

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-block: 1.5rem 2rem;
  }

  .stage {
    overflow: hidden;
    border: 1px solid var(--pv-border);
    border-radius: 0.75rem;
    background: var(--pv-bg);
  }
  .stage-bar {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.5rem;
    border-bottom: 1px solid var(--pv-border);
    background: var(--pv-surface);
  }
  .canvas {
    container-type: inline-size;
    display: grid;
    place-items: center;
    min-height: 18rem;
    padding: 2rem 1.25rem;
  }
  .motion-note {
    display: none;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-top: 1px solid var(--pv-border);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .motion-note {
      display: block;
    }
    [data-replay] {
      display: none;
    }
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-block-size: 2rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--pv-border);
    border-radius: 0.375rem;
    background: var(--pv-bg);
    font: inherit;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .action:hover:not([aria-disabled="true"]) {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .action:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }
  .action[aria-disabled="true"] {
    opacity: 0.5;
    cursor: default;
  }

  .tweaks {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 1rem 1.5rem;
  }
  .tweak {
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    margin-bottom: 0.375rem;
    padding: 0;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .segmented {
    display: inline-flex;
    padding: 0.1875rem;
    border: 1px solid var(--pv-border);
    border-radius: 0.5rem;
    background: var(--pv-surface);
  }
  .segmented label {
    position: relative;
  }
  .segmented span {
    display: block;
    padding: 0.25rem 0.75rem;
    border-radius: 0.3125rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .segmented span:hover {
    color: var(--sl-color-white);
  }
  .segmented input:checked + span {
    background: var(--sl-color-accent-low);
    box-shadow: inset 0 0 0 1px var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .segmented input:focus-visible + span {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 1px;
  }

  .more {
    display: flex;
    flex-basis: 100%;
    align-items: start;
    gap: 1rem;
  }
  .fine-tune {
    flex: 1;
  }
  .fine-tune summary {
    width: fit-content;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .fine-tune summary:hover {
    color: var(--sl-color-white);
  }
  .ranges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem 1.5rem;
    margin-top: 0.75rem;
  }
  .range {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .range output {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-white);
  }
  .range input {
    grid-column: 1 / -1;
    width: 100%;
    margin: 0;
    accent-color: var(--sl-color-accent);
  }

  .snippets {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  [data-snippet] + [data-snippet] {
    margin-top: 1rem;
  }

  /* Forced colors remove the backgrounds and shadows that show these states. */
  @media (forced-colors: active) {
    .action[aria-disabled="true"] {
      border-color: GrayText;
      color: GrayText;
    }
    .segmented input:checked + span {
      background: Highlight;
      color: HighlightText;
    }
  }

  @media (pointer: coarse) {
    .action,
    .fine-tune summary,
    .segmented span {
      min-block-size: 2.75rem;
    }
    .segmented span {
      display: flex;
      align-items: center;
    }
  }

  @media print {
    .example :global([data-reveal]) {
      opacity: 1 !important;
    }
  }
</style>
