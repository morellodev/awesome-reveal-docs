---
import RotateCcw from "@lucide/astro/icons/rotate-ccw";
import { Reveal, type RevealOptions } from "@awesome-reveal/astro";
import "./shapes.css";

interface Props extends Pick<
  RevealOptions,
  "keyframes" | "duration" | "delay" | "stagger" | "once" | "threshold"
> {
  /** The code that the caption shows. */
  code?: string;
  /** A plain-text caption, for demos that no short code describes. */
  label?: string;
  /** The number of bars to stagger. */
  items?: number;
  /** A text to stagger one character at a time. */
  text?: string;
}

const {
  code,
  label,
  items = 3,
  text,
  duration = 1200,
  threshold = 0.5,
  ...options
} = Astro.props;
const caption = code ?? label;
---

<figure class="demo" data-demo>
  <div class="stage" data-markdown-ignore>
    {text ? (
      <Reveal
        as="span"
        class="text"
        aria-hidden="true"
        duration={duration}
        threshold={threshold}
        {...options}
      >
        {[...text].map((char) => (
          <span>{char}</span>
        ))}
      </Reveal>
    ) : options.stagger ? (
      <Reveal
        class="bars"
        duration={duration}
        threshold={threshold}
        {...options}
      >
        {Array.from({ length: items }, () => (
          <div class="bar demo-shape demo-shape-pill" />
        ))}
      </Reveal>
    ) : (
      <Reveal
        class="box demo-shape demo-shape-square"
        duration={duration}
        threshold={threshold}
        {...options}
      />
    )}
    <button type="button" class="replay" title={`Replay ${caption}`} hidden>
      <RotateCcw size="1em" />
      <span class="sr-only">Replay {caption}</span>
    </button>
  </div>
  <figcaption>{code ? <code>{code}</code> : label}</figcaption>
</figure>

<script>
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reducedMotion)
    for (const demo of document.querySelectorAll<HTMLElement>("[data-demo]")) {
      const button = demo.querySelector("button")!;
      const host = () => demo.querySelector("awesome-reveal")!;
      // Before the reveal, a replay would animate a hidden element.
      const showButton = () => {
        button.hidden =
          host().firstElementChild!.getAttribute("data-reveal") === "hidden";
      };
      const observer = new MutationObserver(showButton);
      const watch = () => {
        observer.disconnect();
        observer.observe(host().firstElementChild!, {
          attributeFilter: ["data-reveal"],
        });
        showButton();
      };

      watch();
      button.addEventListener("click", () => {
        // A new <awesome-reveal> element hides its child and reveals it again.
        host().replaceWith(host().cloneNode(true));
        watch();
      });
    }
</script>

<style>
  .demo {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-black);
  }
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    height: 9rem;
    overflow: hidden;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .box {
    width: 3.5rem;
    height: 3.5rem;
  }
  .bars {
    display: grid;
    gap: 0.5rem;
    width: 60%;
  }
  .bar {
    height: 1rem;
  }
  .text {
    font-size: var(--sl-text-2xl);
    font-weight: 600;
    color: var(--sl-color-white);
    white-space: pre;
  }
  /* Transforms do not apply to inline elements. */
  .text > span {
    display: inline-block;
  }
  figcaption {
    padding: 0.75rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  code {
    font-family: var(--__sl-font-mono);
    color: var(--sl-color-white);
  }
  .replay {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    padding: 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999rem;
    background: none;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .replay:hover,
  .replay:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .replay[hidden] {
    display: none;
  }
  @media print {
    .stage :global([data-reveal]) {
      opacity: 1 !important;
    }
  }
</style>
