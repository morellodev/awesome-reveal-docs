---
import RotateCcw from "@lucide/astro/icons/rotate-ccw";
import { hiddenStyle, type RevealOptions } from "@awesome-reveal/core";

interface Props extends Pick<
  RevealOptions,
  "keyframes" | "duration" | "delay" | "stagger" | "once" | "threshold"
> {
  /** The code that the caption shows. */
  code?: string;
  /** A plain-text caption, for demos that no short code describes. */
  label?: string;
  /** The number of bars to stagger. */
  items?: number;
  /** A text to stagger one character at a time. */
  text?: string;
}

const {
  code,
  label,
  items = 3,
  text,
  duration = 1200,
  threshold = 0.5,
  ...options
} = Astro.props;
const caption = code ?? label;
---

<figure
  class="demo"
  data-demo={JSON.stringify({ ...options, duration, threshold })}
>
  <div class="stage">
    {text ? (
      <span
        class="text"
        style={hiddenStyle}
        data-reveal="hidden"
        data-demo-target
        aria-hidden="true"
      >
        {[...text].map((char) => (
          <span>{char}</span>
        ))}
      </span>
    ) : options.stagger ? (
      <div
        class="bars"
        style={hiddenStyle}
        data-reveal="hidden"
        data-demo-target
      >
        {Array.from({ length: items }, () => (
          <div class="bar" />
        ))}
      </div>
    ) : (
      <div
        class="box"
        style={hiddenStyle}
        data-reveal="hidden"
        data-demo-target
      />
    )}
    <button type="button" class="replay" title={`Replay ${caption}`} hidden>
      <RotateCcw size="1em" />
      <span class="sr-only">Replay {caption}</span>
    </button>
  </div>
  <figcaption>{code ? <code>{code}</code> : label}</figcaption>
</figure>

<script>
  import { observe, play, reveal } from "@awesome-reveal/core";

  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const demo of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const target = demo.querySelector<HTMLElement>("[data-demo-target]")!;
    const button = demo.querySelector("button")!;
    const options = JSON.parse(demo.dataset.demo!);
    let cancel = () => {};

    reveal(target, options);
    // Before the reveal, a replay would animate a hidden element.
    if (!reducedMotion)
      observe(target, options, (inView) => {
        button.hidden = !inView;
      });
    button.addEventListener("click", () => {
      cancel();
      cancel = play(target, options);
    });
  }
</script>

<style>
  .demo {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-black);
  }
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    height: 9rem;
    overflow: hidden;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .box,
  .bar {
    background: linear-gradient(
      135deg,
      var(--sl-color-accent),
      var(--sl-color-accent-high)
    );
  }
  .box {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 0.75rem;
  }
  .bars {
    display: grid;
    gap: 0.5rem;
    width: 60%;
  }
  .bar {
    height: 1rem;
    border-radius: 999rem;
  }
  .text {
    font-size: var(--sl-text-2xl);
    font-weight: 600;
    color: var(--sl-color-white);
    white-space: pre;
  }
  /* Transforms do not apply to inline elements. */
  .text > span {
    display: inline-block;
  }
  figcaption {
    padding: 0.75rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  code {
    font-family: var(--__sl-font-mono);
    color: var(--sl-color-white);
  }
  .replay {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    padding: 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999rem;
    background: none;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .replay:hover,
  .replay:focus-visible {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .replay[hidden] {
    display: none;
  }
  @media print {
    [data-demo-target] {
      opacity: 1 !important;
    }
  }
</style>
