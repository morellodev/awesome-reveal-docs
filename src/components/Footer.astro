---
import Default from "@astrojs/starlight/components/Footer.astro";
import Heart from "@lucide/astro/icons/heart";
import { siteConfig } from "../site.config";
---

<Default />
<div class="site-footer">
  <p>
    <span>
      Released under the{" "}
      <a href={`${siteConfig.repoUrl}/blob/HEAD/LICENSE`}>MIT License</a>.
    </span>{" "}
    <span>
      Copyright © 2019-present{" "}
      <a href={siteConfig.author.url}>{siteConfig.author.name}</a>.
    </span>
  </p>
  <a class="sponsor" href={siteConfig.sponsorUrl}>
    <Heart color="var(--sl-color-red)" />
    Sponsor on GitHub
  </a>
</div>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  span {
    white-space: nowrap;
  }

  p a {
    color: var(--sl-color-gray-2);
    text-decoration-color: color-mix(in oklab, currentColor 35%, transparent);
    text-underline-offset: 0.2em;
  }

  p a:hover {
    color: var(--sl-color-white);
    text-decoration-color: currentColor;
  }

  .sponsor {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 1em;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--hover-duration) ease;
  }

  .sponsor:hover {
    border-color: var(--sl-color-red);
  }
</style>
