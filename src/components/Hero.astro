---
import { Badge, LinkButton } from "@astrojs/starlight/components";
import DraftContentNotice from "@astrojs/starlight/components/DraftContentNotice.astro";
import { Cascade, Reveal } from "@awesome-reveal/astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ExternalLink from "@lucide/astro/icons/external-link";
import Github from "../assets/github.svg";

// The hero schema of Starlight accepts only its own icon names, so the frontmatter name picks the icon here.
const icons = {
  external: ExternalLink,
  github: Github,
  "right-arrow": ArrowRight,
};

const { id, entry } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const words = title.split(" ");
// Starlight's generated 404 page has no actions, so it gives no way back.
const heroActions =
  id === "404" && actions.length === 0
    ? [
        {
          text: "Go to the home page",
          link: "/",
          variant: "primary" as const,
          icon: { type: "icon" as const, name: "right-arrow" as const },
          attrs: {},
        },
      ]
    : actions;
---

<div class="hero">
  {id === "" && (
    <Reveal as="p" class="eyebrow" from={{ opacity: 0 }}>
      <code>@awesome-reveal/*</code>
      <Badge text="Prerelease" variant="tip" />
    </Reveal>
  )}
  <Cascade
    as="h1"
    id="_top"
    data-page-title
    interval={110}
    duration={900}
    from={{ opacity: 0, y: "0.35em" }}
  >
    {words.map((word) => (
      <>
        <span set:html={word} />{" "}
      </>
    ))}
  </Cascade>
  {data.draft && <DraftContentNotice />}
  {tagline && (
    <Reveal as="p" class="tagline" delay={250}>
      <Fragment set:html={tagline} />
    </Reveal>
  )}
  {heroActions.length > 0 && (
    <Reveal class="actions" delay={350} from={{ opacity: 0, y: 12 }}>
      {heroActions.map(({ attrs, icon, link, text, variant }) => {
        const Icon =
          icon?.type === "icon"
            ? icons[icon.name as keyof typeof icons]
            : undefined;
        return (
          <LinkButton href={link} variant={variant} {...attrs}>
            {text}
            {Icon && <Icon aria-hidden="true" width="1em" height="1em" />}
          </LinkButton>
        );
      })}
    </Reveal>
  )}
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
    padding-block: clamp(3rem, 2rem + 12vmin, 9rem)
      clamp(2rem, 1rem + 6vmin, 5rem);
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    color: var(--hint);
    font-weight: 600;
  }

  h1 {
    color: var(--sl-color-white);
    font-size: clamp(3rem, 1rem + 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  h1 span {
    display: inline-block;
  }

  .tagline {
    max-width: 36rem;
    color: var(--sl-color-gray-2);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .sl-link-button :global(svg) {
    font-size: 1.5rem;
  }

  .sl-link-button {
    font-weight: 700;
    translate: 0;
    transition: translate var(--hover-duration) ease;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .sl-link-button:hover {
      translate: 0 -2px;
    }

    .sl-link-button:active {
      translate: 0 1px;
    }
  }
</style>
