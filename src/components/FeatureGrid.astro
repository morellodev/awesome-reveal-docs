---
import { Reveal } from "@awesome-reveal/astro";
---

<Reveal class="feature-grid" duration={1000} stagger={150}>
  <slot />
</Reveal>

<style>
  /* The same grid as the Starlight CardGrid, which cannot render the hidden state on the server. */
  .feature-grid {
    display: grid;
    grid-template-columns: 100%;
    gap: 1rem;
    /* Starlight spaces siblings with `* + *`, which skips the child of the `display: contents` host. */
    margin-top: 1rem;
  }
  .feature-grid > :global(*) {
    margin-top: 0 !important;
  }
  @media (min-width: 50rem) {
    .feature-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }
  @media print {
    .feature-grid {
      opacity: 1 !important;
    }
  }
</style>
