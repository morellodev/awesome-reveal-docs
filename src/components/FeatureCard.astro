---
import { Icon as StarlightIcon } from "@astrojs/starlight/components";
import PersonStanding from "@lucide/astro/icons/person-standing";
import AppWindow from "@lucide/astro/icons/app-window";
import Bot from "@lucide/astro/icons/bot";
import Feather from "@lucide/astro/icons/feather";
import Server from "@lucide/astro/icons/server";
import Spline from "@lucide/astro/icons/spline";
import Zap from "@lucide/astro/icons/zap";

const lucideIcons = {
  "person-standing": PersonStanding,
  "app-window": AppWindow,
  bot: Bot,
  feather: Feather,
  server: Server,
  spline: Spline,
  zap: Zap,
};

interface Props {
  title: string;
  // Lucide has no brand logos, so the TypeScript logo comes from Starlight.
  icon: keyof typeof lucideIcons | "seti:typescript";
  color: "orange" | "purple" | "green" | "red" | "blue";
}

const { title, icon, color } = Astro.props;
const LucideIcon = icon === "seti:typescript" ? undefined : lucideIcons[icon];
---

<article
  class="feature-card"
  style={`--feature-color: var(--sl-color-${color}); --feature-color-low: var(--sl-color-${color}-low);`}
>
  <p class="title">
    {LucideIcon ? (
      <LucideIcon class="icon" size="0.85em" aria-hidden="true" />
    ) : (
      <StarlightIcon name="seti:typescript" class="icon" size="0.85em" />
    )}
    <span>{title}</span>
  </p>
  <div class="body">
    <slot />
  </div>
</article>

<style>
  /* The same layout as the Starlight Card, which accepts only Starlight icons. */
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
    border: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-black);
    padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
  }
  .title {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin: 0;
    font-weight: 600;
    font-size: var(--sl-text-h4);
    color: var(--sl-color-white);
    line-height: var(--sl-line-height-headings);
  }
  .icon {
    flex-shrink: 0;
    box-sizing: content-box;
    padding: 0.2em;
    border: 1px solid var(--feature-color);
    border-radius: 0.25rem;
    background-color: var(--feature-color-low);
  }
  .body {
    margin: 0;
    font-size: clamp(
      var(--sl-text-sm),
      calc(0.5rem + 1vw),
      var(--sl-text-body)
    );
  }
</style>
