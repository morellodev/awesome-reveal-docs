{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "awesome-reveal-website",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "routes": [{ "pattern": "awesome-reveal.dev", "custom_domain": true }],
}
